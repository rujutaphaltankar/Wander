# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database ----
# SQLite — a single file on disk. No server, no Docker, nothing else to install.
# Path is relative to backend/prisma/ (where schema.prisma lives), so this
# creates backend/prisma/dev.db the first time you run a migration.
DATABASE_URL=file:./dev.db

# If you ever want to move to a real Postgres server later (e.g. for production),
# change the provider in prisma/schema.prisma back to "postgresql" and use:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=replace_with_another_long_random_string
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# ---- OAuth (optional — leave blank to disable) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# ---- AI provider ----
# Supports "groq" (recommended, ultra-fast), "anthropic", or "openai".
# Provide the matching key below.
AI_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Maps (frontend also needs this, see frontend/.env.example) ----
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ---- Weather ----
WEATHER_API_KEY=
WEATHER_PROVIDER=openweathermap

# ---- Storage ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Notifications ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
